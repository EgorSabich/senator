{
  "name": "senator-academy",
  "version": "0.2.0",
  "private": true,
  "description": "Senator Academy — wewnętrzna platforma szkoleniowa restauracji Senator",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:staging": "CLOUDFLARE_ENV=staging npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts",
    "test:int": "./scripts/test-integration.sh",
    "test:smoke": "./scripts/smoke-local.sh",
    "test:all": "npm run typecheck && npm test && npm run test:smoke && npm run test:int"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261014.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  }
}
